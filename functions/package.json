{
  "name": "aivy-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "vitest run",
    "wipe-user-firestore": "node scripts/clearUserFirestore.cjs",
    "set-admin-claim": "node scripts/setAdminClaim.cjs",
    "clean": "rimraf lib",
    "build": "npm run clean && tsc",
    "build:watch": "tsc --watch",
    "deploy": "firebase deploy --only functions",
    "deploy:force": "npm run build && firebase deploy --only functions --force",
    "serve": "npm run build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.0",
    "@google-cloud/speech": "^6.7.1",
    "@google-cloud/text-to-speech": "^5.8.0",
    "@types/luxon": "^3.7.1",
    "dotenv": "^16.4.7",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.5",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  }
}
